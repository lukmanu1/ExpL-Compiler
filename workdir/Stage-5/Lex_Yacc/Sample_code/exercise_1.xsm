type
  student{
    int roll;
    str name;
  }
endtype

decl
  int swap(int* a, int* b);
enddecl

int swap(int* a, int* b){
    decl
        int temp;
    enddecl

    begin
        temp = *a;
        *a = *b;
        *b = temp;
        return 0;
    end;
}

int main(){
  decl
    int a,b,temp;
  enddecl

  begin
    read(a);
    read(b);
    
    temp = swap(&a, &b);
    write(a);
    write(b);
  end;
}