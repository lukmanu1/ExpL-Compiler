type
    List{
        int data;
        List next;
    }
endtype

decl
    List array[10];
    int temp;
    int display(List node);
enddecl

int display(List node)
{
  decl
    int temp;
  enddecl

  begin
    if (node != null) then
      write(node.data*10);
      temp = display(node.next);
    endif;
    return 0;
  end;
}

int main(){
    decl
     int i, y, length, x, temp;
     List head, p, q;
    enddecl

    begin
      initialise();
      i = 0;
      while(i<10){
        array[i] = null;
        i = i + 1;
      }
      head = array[5];
      read(length);

      while (length != 0){
        read(x);
        p = alloc();
        p.data = x;
        p.next = null;

        if (head == null) then
          head = p;
          q = p;
        else
          q.next = p;
          q = q.next;
        endif;

        length = length - 1;
     }

     array[5] = head;

    temp = display(array[5]);
    return 0;
    end;
}