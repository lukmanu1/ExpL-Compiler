Terminals unused in grammar

    NOT


State 0 conflicts: 1 shift/reduce


Grammar

    0 $accept: Program $end

    1 Program: TypeDefBlockAndGDeclBlock FDefBlock MainBlock
    2        | TypeDefBlockAndGDeclBlock MainBlock
    3        | MainBlock

    4 TypeDefBlockAndGDeclBlock: TypeDefBlock GDeclBlock
    5                          | GDeclBlock
    6                          | TypeDefBlock
    7                          | %empty

    8 TypeDefBlock: TYPE TypeDefList ENDTYPE

    9 TypeDefList: TypeDefList TypeDef
   10            | TypeDef

   11 TypeDef: ID '{' FieldDeclList '}'

   12 FieldDeclList: FieldDeclList FieldDecl
   13              | FieldDecl

   14 FieldDecl: Type ID ';'

   15 GDeclBlock: DECL GDeclList ENDDECL
   16           | DECL ENDDECL

   17 GDeclList: GDeclList GDecl
   18          | GDecl

   19 GDecl: Type GidList ';'

   20 GidList: GidList ',' Gid
   21        | Gid

   22 Gid: ID
   23    | ID '[' NUM ']'
   24    | ID '(' ParamList ')'
   25    | '*' ID

   26 FDefBlock: FDefBlock Fdef
   27          | Fdef

   28 $@1: %empty

   29 Fdef: INT ID '(' ParamList ')' '{' LdeclBlock $@1 Body '}'

   30 $@2: %empty

   31 Fdef: STR ID '(' ParamList ')' '{' LdeclBlock $@2 Body '}'

   32 ParamList: ParamList ',' Param
   33          | Param
   34          | %empty

   35 Param: INT '*' ID
   36      | STR '*' ID
   37      | INT ID
   38      | STR ID

   39 LdeclBlock: DECL LDecList ENDDECL
   40           | DECL ENDDECL

   41 LDecList: LDecList LDecl
   42         | LDecl

   43 LDecl: Type IdList ';'

   44 IdList: IdList ',' '*' ID
   45       | IdList ',' ID
   46       | '*' ID
   47       | ID

   48 Type: INT
   49     | STR
   50     | ID

   51 $@3: %empty

   52 MainBlock: INT MAIN '(' ')' '{' LdeclBlock $@3 Body '}'

   53 Body: PBEGIN Slist END ';'
   54     | PBEGIN END ';'

   55 Slist: Slist Stmt
   56      | Stmt

   57 Stmt: InputStmt
   58     | OutputStmt
   59     | AsgStmt
   60     | IfStmt
   61     | whileStmt
   62     | doWhileStmt
   63     | repeatStmt
   64     | breakStmt
   65     | continueStmt
   66     | returnStmt

   67 InputStmt: READ '(' ID ')' ';'
   68          | READ '(' ID '[' E ']' ')' ';'
   69          | READ '(' ID '.' ID ')' ';'

   70 OutputStmt: WRITE '(' E ')' ';'

   71 AsgStmt: ID EQUAL E ';'
   72        | ID '[' E ']' EQUAL E ';'
   73        | '*' ID EQUAL E ';'
   74        | ID '.' ID EQUAL E ';'

   75 IfStmt: IF '(' E ')' THEN Slist ELSE Slist ENDIF ';'
   76       | IF '(' E ')' THEN Slist ENDIF ';'

   77 whileStmt: WHILE '(' E ')' '{' Slist '}'

   78 doWhileStmt: DO '{' Slist '}' WHILE '(' E ')' ';'

   79 repeatStmt: REPEAT '{' Slist '}' UNTIL '(' E ')' ';'

   80 breakStmt: BREAK ';'

   81 continueStmt: CONTINUE ';'

   82 returnStmt: RETURN E ';'
   83           | RETURN ';'

   84 E: E '+' E
   85  | E '-' E
   86  | E '*' E
   87  | E '/' E
   88  | E '%' E
   89  | E LT E
   90  | E GT E
   91  | E LE E
   92  | E GE E
   93  | E EQ E
   94  | E NE E
   95  | ID '(' ')'
   96  | ID '(' ArgList ')'
   97  | NUM
   98  | STRING_LITERAL
   99  | ID
  100  | '(' E ')'
  101  | ID '[' E ']'
  102  | AND ID
  103  | '*' ID
  104  | ID '.' ID

  105 ArgList: ArgList ',' E
  106        | E


